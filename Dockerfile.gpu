# Stem Separator — NVIDIA GPU (CUDA 12) Dockerfile
# Requires NVIDIA GPU driver + NVIDIA Container Toolkit on the host.
# Build & run with Docker Compose override:
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d --build

FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    AUDIO_SEPARATOR_MODEL_DIR=/data/models \
    STEM_SEPARATOR_OUTPUT_DIR=/data/output \
    STEM_SEPARATOR_HOST=0.0.0.0 \
    STEM_SEPARATOR_PORT=7860

LABEL maintainer="Fernando Paladini <fernando@paladini.dev>"
LABEL description="Stem Separator (NVIDIA GPU) - CUDA-accelerated audio track separation"
LABEL version="1.0.0-gpu"

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    ffmpeg \
    libsndfile1 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean \
    && ln -sf /usr/bin/python3 /usr/bin/python

WORKDIR /app

COPY requirements.txt .

# Install CUDA 12 PyTorch, ONNX Runtime GPU, and audio-separator[gpu]
RUN python -m pip install --no-cache-dir --upgrade pip && \
    python -m pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu126 && \
    python -m pip install --no-cache-dir "audio-separator[gpu]>=0.48.0,<1.0.0" \
        fastapi "uvicorn[standard]" python-multipart jinja2 pydantic audioread soundfile pydub httpx && \
    python -m pip install --no-cache-dir --force-reinstall torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu126 && \
    python -m pip install --no-cache-dir --force-reinstall onnxruntime-gpu

COPY main.py .
COPY src ./src
COPY templates ./templates
COPY static ./static

RUN mkdir -p /data/models /data/output && \
    chmod 777 /data/models /data/output

EXPOSE 7860
VOLUME ["/data/models", "/data/output"]

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -fsS http://localhost:7860/health || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "7860"]
